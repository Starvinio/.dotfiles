include ~/.config/sway/input.conf
include ~/.config/sway/colors.conf
include ~/.config/sway/keybinds.conf
include ~/.config/sway/bar.conf

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS
exec_always export XDG_CURRENT_DESKTOP=sway

### Exec on startup
exec_always gammastep -l 51.49:9.14 -t 6500:3000 -b 1.0:0.4
exec $term

### Layout
default_border normal 1
font pango:Iosevka 10.5
smart_gaps on
title_align center
focus_follows_mouse no

include /etc/sway/config.d/*
