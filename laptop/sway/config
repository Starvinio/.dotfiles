exec ~/.config/sway/autostart.sh
exec_always {
	export XDG_CURRENT_DESKTOP=sway
	gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
	gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
}

### Outputs
output eDP-1     scale 2 mode  2880x1800@60.001Hz
output HDMI-A-1  scale 2 

### Input settings
input type:keyboard {
   xkb_layout "de"
}

### Input settings
input type:mouse {
	accel_profile flat
}

input type:touchpad {
   dwt enabled
   dwtp enabled
   tap enabled
   tap_button_map lrm
   natural_scroll enabled
   middle_emulation enabled
}

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term footclient
set $menu fuzzel --terminal=$term
set $lock swaylock -fC ~/.config/sway/swaylock.config

exec swayidle -w \
    before-sleep '$lock' \
	lock '$lock'

### Layout
focus_wrapping workspace
default_border normal 1
seat seat0 xcursor_theme phinger-cursors-dark 24
font pango:JetbrainsMono 9
smart_borders on
title_align left
# focus_follows_mouse yes # keep disabled because of touchpad weirdness

### Key bindings
	bindsym $mod+Shift+x    exec $lock
    bindsym $mod+Return     exec $term
    bindsym $mod+numbersign exec ~/.config/sway/fuzzel-exec.sh
	bindsym $mod+n			exec ~/.config/sway/quick-note.sh
	bindsym $mod+shift+n	exec $term nvim ~/.note.md && sort ~/.note.md -o ~/.note.md
	bindsym $mod+F12		exec $term nvim ~/MD/active/workflow/sway_setup.md
	bindsym $mod+F1 		exec btctl connect
	bindsym $mod+shift+F1   exec btctl disconnect
    bindsym $mod+Shift+q    kill
    bindsym $mod+d          exec $menu
    bindsym $mod+shift+d    exec ~/.config/sway/file-search.sh
    bindsym $mod+Shift+c    exec swaymsg reload

    floating_modifier $mod normal

    bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'

    ### Focus movement
    bindsym $mod+$left  focus left
    bindsym $mod+$down  focus down
    bindsym $mod+$up    focus up
    bindsym $mod+$right focus right

    ### Window movement
    bindsym $mod+Shift+$left    move left
    bindsym $mod+Shift+$down    move down
    bindsym $mod+Shift+$up      move up
    bindsym $mod+Shift+$right   move right

    # Workspaces
    bindsym $mod+u workspace number 1
    bindsym $mod+i workspace number 2
    bindsym $mod+o workspace number 3
    bindsym $mod+p workspace number 4
    bindsym $mod+7 workspace number 5
    bindsym $mod+8 workspace number 6
    bindsym $mod+9 workspace number 7
    bindsym $mod+0 workspace number 8

    # Mousecontrol for browsing
    bindsym --whole-window $mod+button8 		focus next
    bindsym --whole-window $mod+button9 		focus prev
    bindsym --whole-window $mod+shift+button8 	workspace prev
    bindsym --whole-window $mod+shift+button9 	workspace next

    bindsym $mod+Shift+u move container to workspace number 1
    bindsym $mod+Shift+i move container to workspace number 2
    bindsym $mod+Shift+o move container to workspace number 3
    bindsym $mod+Shift+p move container to workspace number 4
    bindsym $mod+Shift+7 move container to workspace number 5
    bindsym $mod+Shift+8 move container to workspace number 6
    bindsym $mod+Shift+9 move container to workspace number 7
    bindsym $mod+Shift+0 move container to workspace number 8

    ### Layout
    bindsym $mod+b 				splith
    bindsym $mod+v 				splitv
    bindsym $mod+w 				layout tabbed
    bindsym $mod+e 				layout toggle split
    bindsym $mod+f 				fullscreen
    bindsym $mod+Shift+space	floating toggle
    bindsym $mod+space 			focus mode_toggle

	# Set coding size manually
	bindsym $mod+c 			move position center

	# screenshot
    bindsym $mod+Print exec grim -g "$(slurp)" - | wl-copy
    bindsym $mod+Shift+Print exec sh -c 'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png'

	bindsym $mod+Shift+G exec grim -g "$(slurp -p)" -t ppm - | convert - -format '%[pixel:p{0,0}]' txt:- | tail -n 1 | cut -d ' ' -f 4 | wl-copy

	bindsym $mod+period exec makoctl dismiss 

	for_window [app_id="Notes"] floating enable
	for_window [app_id="Notes"] resize set width 50 ppt height 70 ppt
	for_window [app_id="Notes"] move position center

### Resize mode
mode "resize" {
    bindsym $left  resize shrink width  10px
    bindsym $down  resize grow   height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow   width  10px

    bindsym Left  resize shrink width  10px
    bindsym Down  resize grow   height 10px
    bindsym Up    resize shrink height 10px
    bindsym Right resize grow   width  10px

    bindsym Return  mode "default"
    bindsym Escape  mode "default"
}
bindsym $mod+r mode "resize"

# logout, restart, poweroff...
set $mode_system System (e) logout, (Ctrl+r) reboot, (Ctrl+s) shutdown

mode "$mode_system" {
    bindsym e exec --no-startup-id swaymsg exit, mode "default"
    bindsym Ctrl+r exec --no-startup-id systemctl reboot, mode "default"
    bindsym Ctrl+s exec --no-startup-id systemctl poweroff -i, mode "default"

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
	bindsym $mod+backspace mode "$mode_system"


# Utilities:
	# turn screen off on idle
	bindswitch --locked --reload lid:on  output eDP-1 disable
	bindswitch --locked --reload lid:off output eDP-1 enable
	bindsym --locked $mod+delete output eDP-1 enable
	bindsym --locked $mod+shift+delete output eDP-1 disable
    # Special keys to adjust volume via PulseAudio
	bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && pkill -RTMIN+3 -f status-improved.sh
	bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && pkill -RTMIN+3 -f status-improved.sh
	bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && pkill -RTMIN+3 -f status-improved.sh
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
    # Special keys to adjust brightness via brightnessctl
	bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%- && pkill -RTMIN+3 -f status-improved.sh
	bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+ && pkill -RTMIN+3 -f status-improved.sh


set $FG #839496
set $LBLUE #607f8e
set $DBLUE #304f5e

## Bar
bar {
    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.

	position top
    status_command ~/.config/sway/status-improved.sh
    #status_command ~/Code/smollbarr/smollbarr
	colors {
	  background #000000aa
	  statusline $FG
#	  # class		      border	bg	    text
	  focused_workspace   $LBLUE  $DBLUE  	$FG
#	  inactive_workspace  #000000       #000000   	$FG
#	  urgent_workspace    #FF5555  #FF5555 	#F8F8F2
	  binding_mode        #95686b  #65383b 	$FG
	}
}

## background
# output * bg #d1d5da solid_color
 
# class                 	border    bg	    text      indicator c_border
client.focused          	$LBLUE    $DBLUE    $FG    	  $LBLUE    $LBLUE
#client.unfocused        	$GREY     $GREY     $DGREY    $GREY     $BG
#client.focused_inactive 	$DGREY    $GREY    	$FG       $GREY     $GREY
#client.urgent           	b03030    f2eedf    b03030    b03030    b03030


include /etc/sway/config.d/*
